# Локальные адреса. Не публикуйте API наружу без отдельной защиты.
POSTGRES_DB=lidoskop
POSTGRES_USER=lidoskop
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://lidoskop:change-me@postgres:5432/lidoskop
REDIS_URL=redis://redis:6379/0
API_HOST=127.0.0.1
API_PORT=8000
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1

# Сгенерируйте: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
LIDOSKOP_MASTER_KEY=
APP_ENV=development
LOG_LEVEL=INFO
CRAWLER_USER_AGENT=Lidoskop/0.1 (+local-research; contact=owner)
CRAWLER_MAX_PAGES=12
CRAWLER_TIMEOUT_SECONDS=15
DATA_RETENTION_DAYS=180

